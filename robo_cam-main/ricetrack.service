[Unit]
Description=RiceTrack Agricultural Rover Web Server & Vision Service
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/robo_cam-main/robo_cam-main
Environment="PATH=/home/pi/robo_cam-main/robo_cam-main/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="RICETRACK_HOST=0.0.0.0"
Environment="RICETRACK_PORT=8000"
ExecStart=/home/pi/robo_cam-main/robo_cam-main/.venv/bin/python3 web_app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
